---
import Icon from './Icon.astro';
import ProductMock from './ProductMock.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { product: CollectionEntry<'products'>; size?: 'md' | 'lg'; class?: string }
const { product, size = 'md', class: className = '' } = Astro.props;
const { data, id } = product;
const lg = size === 'lg';
---
<a
  href={`/products/${id}`}
  class:list={[
    'spotlight reveal group flex h-full flex-col rounded-[var(--radius)] border border-line bg-surface transition-[border-color,box-shadow] duration-[var(--dur-base)] hover:border-line-strong hover:shadow-soft',
    lg ? 'p-7 md:p-9' : 'p-6',
    className,
  ]}
>
  <div class="flex items-start justify-between gap-4">
    <span class="meta text-muted">{data.category}</span>
    <span
      class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-line text-ink-soft transition-colors duration-[var(--dur-base)] group-hover:text-accent"
      transition:name={`product-icon-${id}`}
    >
      <Icon name={data.icon} size={20} />
    </span>
  </div>

  {lg && <ProductMock product={product} class="mt-8" />}

  <h3 class:list={['font-medium', lg ? 'mt-8 text-[length:var(--text-h2)] leading-[1.1]' : 'mt-8 text-[length:var(--text-h3)]']}><span class="inline-block" transition:name={`product-title-${id}`}>{data.name}</span></h3>
  <p class:list={['mt-2 flex-1 leading-relaxed text-muted', lg ? 'max-w-md text-base' : 'text-sm']}>{lg ? data.tagline : data.summary}</p>
  <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-ink">
    View product
    <Icon name="arrow" size={16} class="text-accent transition-transform duration-[var(--dur-base)] ease-out group-hover:translate-x-1" />
  </span>
</a>
