---
// Header / footer lockup: ThinkSolv brand mark + wordmark.
import LogoMark from './LogoMark.astro';
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
<span class:list={['inline-flex items-center gap-2.5 font-display font-semibold text-ink', className]}>
  <LogoMark size={26} class="text-accent" />
  <span class="text-[1.15rem] tracking-tight">thinksolv</span>
</span>
