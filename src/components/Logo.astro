---
// Wordmark inspired by the existing ThinkSolv sun mark (coral rays + subtle smile).
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
<span class:list={['inline-flex items-center gap-2 font-display font-semibold text-ink', className]}>
  <svg width="26" height="26" viewBox="0 0 32 32" fill="none" aria-hidden="true" class="text-accent shrink-0">
    <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <path d="M16 3.5v3"/><path d="M16 25.5v3"/><path d="M3.5 16h3"/><path d="M25.5 16h3"/>
      <path d="m7.2 7.2 2.1 2.1"/><path d="m22.7 22.7 2.1 2.1"/><path d="m24.8 7.2-2.1 2.1"/><path d="m9.3 22.7-2.1 2.1"/>
    </g>
    <circle cx="16" cy="16" r="6.4" fill="currentColor" opacity="0.12"/>
    <circle cx="16" cy="16" r="6.4" stroke="currentColor" stroke-width="1.8"/>
    <path class="ts-smile" d="M13 16.4a3 3 0 0 0 6 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/>
  </svg>
  <span class="text-[1.15rem] tracking-tight">thinksolv</span>
</span>
<style>
  .ts-smile { transition: d 0.3s ease; transform-origin: center; }
  a:hover .ts-smile, span:hover > svg .ts-smile { d: path('M12.4 16a3.6 3.6 0 0 0 7.2 0'); }
</style>
