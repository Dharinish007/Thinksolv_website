---
// Inner-page hero. Plays the shared intro (masked H1 lines + fades) via [data-intro] in motion.ts.
// Slots: `before` (breadcrumb/meta), default (actions under the intro), `aside` (right column).
interface Props {
  eyebrow: string;
  lines: string[];
  accentLast?: boolean;
  intro?: string;
  layout?: '7/5' | '4/8' | 'stacked';
}
const { eyebrow, lines, accentLast = false, intro, layout = 'stacked' } = Astro.props;
const hasAside = Astro.slots.has('aside');
const hasActions = Astro.slots.has('default');
const hasBefore = Astro.slots.has('before');
---
<section class="relative overflow-hidden pt-32 pb-[var(--section-y-sm)] md:pt-40" data-intro>
  <div class="grid-motif pointer-events-none absolute inset-0 -z-10"></div>
  <div class="container-x">
    {layout === '4/8' ? (
      <div class="grid gap-y-6 lg:grid-cols-12 lg:gap-x-8">
        <p class="intro-fade meta text-muted lg:col-span-4 lg:pt-4" style="--d:0ms">{eyebrow}</p>
        <h1 class="line-reveal text-[length:var(--text-h1)] leading-[1.02] tracking-[-0.03em] lg:col-span-8">
          {lines.map((l, i) => <span class="line"><span style={`--i:${i}`} class:list={[accentLast && i === lines.length - 1 && 'text-accent']}>{l}{i < lines.length - 1 ? ' ' : ''}</span></span>)}
        </h1>
        {intro && <p class="intro-fade max-w-xl text-[length:var(--text-lead)] leading-relaxed text-muted lg:col-span-6 lg:col-start-5" style="--d:400ms">{intro}</p>}
        {hasActions && <div class="intro-fade lg:col-span-8 lg:col-start-5" style="--d:500ms"><slot /></div>}
      </div>
    ) : (
      <div class:list={['grid gap-12', layout === '7/5' && 'lg:grid-cols-12 lg:items-end lg:gap-8']}>
        <div class:list={[layout === '7/5' ? 'lg:col-span-7' : 'max-w-4xl']}>
          {hasBefore && <div class="intro-fade mb-8" style="--d:0ms"><slot name="before" /></div>}
          <p class="intro-fade meta mb-6 text-muted" style="--d:0ms">{eyebrow}</p>
          <h1 class="line-reveal text-[length:var(--text-h1)] leading-[1.02] tracking-[-0.03em]">
            {lines.map((l, i) => <span class="line"><span style={`--i:${i}`} class:list={[accentLast && i === lines.length - 1 && 'text-accent']}>{l}{i < lines.length - 1 ? ' ' : ''}</span></span>)}
          </h1>
          {intro && <p class="intro-fade mt-6 max-w-xl text-[length:var(--text-lead)] leading-relaxed text-muted" style="--d:400ms">{intro}</p>}
          {hasActions && <div class="intro-fade mt-8" style="--d:500ms"><slot /></div>}
        </div>
        {hasAside && <div class="intro-fade lg:col-span-5" style="--d:450ms"><slot name="aside" /></div>}
      </div>
    )}
  </div>
</section>
