---
import { cta } from '@/data/site';
import Button from './Button.astro';
interface Props {
  title?: string;
  intro?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
}
const {
  title = 'Let’s build something that stays out of the way.',
  intro = 'Tell us what slows your team down. We’ll help you remove the work before it reaches anyone.',
  primary = cta.primary,
  secondary = cta.secondary,
} = Astro.props;
---
<section class="cta-band relative isolate overflow-hidden bg-ink py-[var(--section-y)] text-on-ink" data-cta>
  <div class="cta-glow pointer-events-none absolute -z-10" aria-hidden="true"></div>
  <div class="container-x">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <p class="reveal meta mb-6 text-on-ink-muted">Start a conversation</p>
        <h2 class="reveal text-[length:var(--text-h1)] leading-[1.04] text-on-ink">{title}</h2>
      </div>
      <div class="reveal lg:col-span-4" style="--reveal-delay:100ms">
        <p class="text-base leading-relaxed text-on-ink-muted md:text-lg">{intro}</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <Button href={primary.href} variant="primary" icon={primary.href.startsWith('mailto:') ? 'mail' : 'arrow'}>{primary.label}</Button>
          <Button href={secondary.href} variant="secondary" onInk>{secondary.label}</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-glow {
    right: -20rem;
    bottom: -28rem;
    width: 60rem;
    height: 60rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(224 72 60 / 0.22), rgb(224 72 60 / 0.06) 55%, transparent);
  }
  /* Hover: the arrow glows red and pulses once; the primary button gets a soft coral halo */
  .cta-band :global(.btn:hover svg) { filter: drop-shadow(0 0 6px var(--color-accent-bright)); }
  .cta-band :global(.btn:hover) { box-shadow: 0 0 0 4px rgb(224 72 60 / 0.18), 0 8px 28px rgb(224 72 60 / 0.35); }
  @media (prefers-reduced-motion: no-preference) {
    .cta-band :global(.btn:hover svg) { animation: cta-arrow-glow 1.2s ease-in-out infinite; }
  }
  @keyframes cta-arrow-glow {
    0%, 100% { filter: drop-shadow(0 0 3px var(--color-accent-bright)); }
    50% { filter: drop-shadow(0 0 9px var(--color-accent-bright)) drop-shadow(0 0 16px var(--color-accent)); }
  }
  /* One slow drift when the band is on screen, then it rests (CSS scroll-driven; static elsewhere) */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .cta-glow {
        animation: cta-drift linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 60%;
      }
    }
  }
  @keyframes cta-drift {
    from { transform: translate(8rem, 6rem) scale(0.9); opacity: 0.4; }
    to { transform: none; opacity: 1; }
  }
</style>
