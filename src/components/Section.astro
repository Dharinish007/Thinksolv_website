---
interface Props {
  id?: string;
  tone?: 'base' | 'surface' | 'ink';
  class?: string;
  contain?: boolean;
}
const { id, tone = 'base', class: className = '', contain = true } = Astro.props;
const tones = {
  base: 'bg-bg text-ink',
  surface: 'bg-surface-2 text-ink',
  ink: 'bg-ink text-[#f3ece8]',
};
---
<section id={id} class:list={['py-16 md:py-24 lg:py-28', tones[tone], className]}>
  {contain ? <div class="container-x"><slot /></div> : <slot />}
</section>
