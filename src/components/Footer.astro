---
import { getCollection } from 'astro:content';
import { site, cta, nav } from '@/data/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Button from './Button.astro';
const year = new Date().getFullYear();
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const socials = [
  { label: 'LinkedIn', href: site.social.linkedin },
  { label: 'X', href: site.social.x },
  { label: 'Chrome Web Store', href: site.social.chromeStore },
].filter((s) => s.href);
const cols = [
  { title: 'Products', links: products.map((p) => ({ label: p.data.name, href: `/products/${p.id}` })) },
  { title: 'Company', links: nav.filter((n) => n.href !== '/').map((n) => ({ label: n.label, href: n.href })) },
];
---
<footer class="relative overflow-hidden border-t border-white/10 bg-ink text-on-ink-muted">
  <div class="container-x pt-20 pb-8">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <div class="[&_span]:text-on-ink"><Logo /></div>
        <p class="mt-4 max-w-xs text-sm leading-relaxed">{site.tagline} Focused tools for document-centric work across Google Workspace and Chrome.</p>
        <div class="mt-6"><Button href={cta.primary.href}>{cta.primary.label}</Button></div>
      </div>
      {cols.map((col, i) => (
        <nav aria-label={col.title} class:list={[i === 0 ? 'lg:col-span-3 lg:col-start-6' : 'lg:col-span-2']}>
          <h3 class="meta text-on-ink-muted/70">{col.title}</h3>
          <ul class="mt-5 space-y-3">
            {col.links.map((l) => (
              <li><a href={l.href} class="link-underline text-sm text-on-ink/85 transition-colors hover:text-on-ink">{l.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
      <div class="lg:col-span-2">
        <h3 class="meta text-on-ink-muted/70">Contact</h3>
        <ul class="mt-5 space-y-3 text-sm">
          <li><a href={`mailto:${site.email}`} class="link-underline inline-flex items-center gap-2 text-on-ink/85 hover:text-on-ink"><Icon name="mail" size={15} />{site.email}</a></li>
          {socials.map((s) => (
            <li><a href={s.href} target="_blank" rel="noopener noreferrer" class="link-underline text-on-ink/85 hover:text-on-ink">{s.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <p class="footer-mark pointer-events-none mt-16 select-none font-display leading-none tracking-[-0.05em] text-on-ink/[0.06]" aria-hidden="true">thinksolv</p>

    <div class="mt-4 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs md:flex-row md:items-center md:justify-between">
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <p class="meta text-on-ink-muted/70">Est. {site.founded}</p>
    </div>
  </div>
</footer>

<style>
  .footer-mark { font-size: clamp(4rem, 19vw, 16.5rem); margin-left: -0.04em; font-weight: 600; }
</style>
