---
// Brand intro: first visit per session only. Rendered hidden; shown only while <html class="preload">,
// which an inline head script sets (so no-JS visitors, crawlers and reduced-motion users never see it).
// motion.ts plays the logo hand-off into the header and removes the class (hard cap ~1.1s).
---
<div id="preloader" aria-hidden="true">
  <svg width="72" height="72" viewBox="0 0 32 32" fill="none" class="text-accent" data-preloader-mark>
    <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <path style="--r:0" d="M16 3.5v3"/><path style="--r:1" d="m24.8 7.2-2.1 2.1"/><path style="--r:2" d="M25.5 16h3"/><path style="--r:3" d="m22.7 22.7 2.1 2.1"/>
      <path style="--r:4" d="M16 25.5v3"/><path style="--r:5" d="m9.3 22.7-2.1 2.1"/><path style="--r:6" d="M3.5 16h3"/><path style="--r:7" d="m7.2 7.2 2.1 2.1"/>
    </g>
    <circle cx="16" cy="16" r="6.4" fill="currentColor" opacity="0.12"/>
    <circle class="pl-ring" cx="16" cy="16" r="6.4" stroke="currentColor" stroke-width="1.8" pathLength="1"/>
    <path class="pl-smile" d="M13 16.4a3 3 0 0 0 6 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" pathLength="1"/>
  </svg>
</div>

<style is:global>
  #preloader { display: none; }
  html.preload #preloader {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    background: var(--color-bg);
    transition: opacity 260ms var(--ease-out);
  }
  html.preload #preloader.is-leaving { opacity: 0; }
  /* The header mark stays hidden until the flying mark lands on it */
  html.preload #site-header [data-logo-mark] { opacity: 0; }

  #preloader [data-preloader-mark] path[style] {
    stroke-dasharray: 3.2;
    stroke-dashoffset: 3.2;
    animation: pl-draw 220ms var(--ease-out) forwards;
    animation-delay: calc(var(--r) * 35ms);
  }
  #preloader .pl-ring {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: pl-draw 360ms var(--ease-out) 60ms forwards;
  }
  #preloader .pl-smile {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: pl-draw 240ms var(--ease-out) 400ms forwards;
  }
  @keyframes pl-draw { to { stroke-dashoffset: 0; } }
</style>
