---
// Brand intro / page-transition loader. Rendered hidden; shown only while <html class="preload">,
// which an inline head script sets on load (and motion.ts sets on every client-side navigation),
// so no-JS visitors, crawlers and reduced-motion users never see it.
// On a fresh load motion.ts flies the mark into the header; on navigation it simply fades out.
import LogoMark from './LogoMark.astro';
---
<div id="preloader" aria-hidden="true">
  <LogoMark size={96} class="text-accent" />
</div>

<style is:global>
  #preloader { display: none; }
  html.preload #preloader {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    background: var(--color-bg);
    transition: opacity 260ms var(--ease-out);
  }
  html.preload #preloader.is-leaving { opacity: 0; }
  /* The header mark stays hidden until the flying mark lands on it (fresh load only) */
  html.preload:not(.preload-nav) #site-header [data-logo-mark] { opacity: 0; }

  /* Rays burst out from the face, then the face pops in and the smile draws across */
  #preloader .lm-ray,
  #preloader .lm-part { transform-box: fill-box; transform-origin: center; }
  #preloader .lm-ray {
    animation: pl-ray 520ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 55ms + 160ms);
  }
  #preloader .lm-part { animation: pl-pop 420ms var(--ease-out) both; }
  #preloader .lm-part-1 { animation-delay: 140ms; }
  #preloader .lm-part-2 { animation-delay: 200ms; }
  #preloader .lm-part-3 { animation: pl-wipe 380ms var(--ease-out) 300ms both; }

  @keyframes pl-ray {
    from { opacity: 0; transform: translate(calc(var(--ux) * -480px), calc(var(--uy) * -480px)) scale(0.25); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes pl-pop {
    from { opacity: 0; transform: scale(0.55) rotate(-10deg); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes pl-wipe {
    from { opacity: 1; clip-path: inset(0 100% 0 0); }
    to   { opacity: 1; clip-path: inset(0 0 0 0); }
  }
</style>
