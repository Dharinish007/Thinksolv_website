---
// StepStory visual for a product's "How it works": input → configure → output, labelled with the
// product's own step title. Decorative; rendered into StepStory's v0/v1/v2 slots.
import Icon from './Icon.astro';
interface Props { step: number; title: string; icon: string }
const { step, title, icon } = Astro.props;
const kind = step % 3;
---
<div class="w-full max-w-[20rem]">
  <p class="meta mb-4 text-center text-muted">{String(step + 1).padStart(2, '0')} · {title}</p>
  {kind === 0 && (
    <div class="rounded-xl border border-line bg-surface p-4 shadow-soft">
      {['Quarterly report', 'Client proposal', 'Meeting notes', 'Roadmap'].map((d, i) => (
        <div class:list={['flex items-center gap-3 rounded-lg px-2 py-2 text-xs text-ink-soft', i === 1 && 'bg-surface-2']}>
          <span class:list={['inline-flex h-4 w-4 items-center justify-center rounded border', i < 2 ? 'border-accent bg-accent text-white' : 'border-line-strong']}>{i < 2 && <Icon name="check" size={11} />}</span>
          <Icon name="doc" size={14} class="text-muted" />{d}
        </div>
      ))}
    </div>
  )}
  {kind === 1 && (
    <div class="space-y-3 rounded-xl border border-line bg-surface p-5 shadow-soft">
      {[['Output', 'Drive folder'], ['Naming', 'Title + date'], ['Formatting', 'Preserve']].map(([k, v], i) => (
        <div class="flex items-center justify-between gap-4 text-xs">
          <span class="text-muted">{k}</span>
          <span class="flex items-center gap-2 text-ink-soft">{v}
            <span class:list={['relative inline-block h-4 w-7 rounded-full', i === 2 ? 'bg-accent' : 'bg-line-strong']}>
              <span class:list={['absolute top-0.5 h-3 w-3 rounded-full bg-white', i === 2 ? 'right-0.5' : 'left-0.5']}></span>
            </span>
          </span>
        </div>
      ))}
      <div class="h-px bg-line"></div>
      <div class="flex justify-end"><span class="rounded-full bg-ink px-3 py-1 text-[0.7rem] text-on-ink">Continue</span></div>
    </div>
  )}
  {kind === 2 && (
    <div class="relative">
      <div class="absolute inset-0 translate-x-3 -translate-y-3 rounded-xl border border-line bg-surface-2"></div>
      <div class="relative rounded-xl border border-line bg-surface p-5 shadow-soft">
        <div class="flex items-center gap-3">
          <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-line text-ink-soft"><Icon name={icon} size={18} /></span>
          <div class="flex-1 space-y-1.5"><span class="block h-2 w-2/3 rounded-full bg-line-strong"></span><span class="block h-1.5 w-1/3 rounded-full bg-line"></span></div>
          <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-accent text-white"><Icon name="check" size={14} /></span>
        </div>
        <div class="mt-4 space-y-2"><span class="block h-1.5 w-full rounded-full bg-line"></span><span class="block h-1.5 w-5/6 rounded-full bg-line"></span><span class="block h-1.5 w-4/6 rounded-full bg-line"></span></div>
      </div>
    </div>
  )}
</div>
