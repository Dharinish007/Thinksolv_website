---
import Icon from './Icon.astro';
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  icon?: string;
  class?: string;
}
const { href, variant = 'primary', icon = 'arrow', class: className = '' } = Astro.props;

const base =
  'group inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2';
const variants = {
  primary:
    'bg-accent text-white shadow-soft hover:bg-accent-hover hover:shadow-lift hover:-translate-y-0.5',
  secondary:
    'bg-surface text-ink border border-line hover:border-accent/40 hover:-translate-y-0.5 hover:shadow-soft',
  ghost: 'text-ink-soft hover:text-accent px-0 py-0',
};
const external = href.startsWith('http');
---
<a
  href={href}
  class:list={[base, variants[variant], className]}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  <slot />
  <Icon name={icon} size={16} class="transition-transform duration-200 group-hover:translate-x-0.5" />
</a>
