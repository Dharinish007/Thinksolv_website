---
import Icon from './Icon.astro';
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  icon?: string;
  onInk?: boolean;
  class?: string;
}
const { href, variant = 'primary', icon = 'arrow', onInk = false, class: className = '' } = Astro.props;

const base =
  'btn group inline-flex items-center gap-2 rounded-full text-sm font-medium transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--dur-base)] ease-out active:scale-[0.98]';
const variants = {
  primary: 'bg-accent-strong px-5 py-2.5 text-white shadow-soft hover:bg-accent-hover',
  secondary: onInk
    ? 'border border-white/20 px-5 py-2.5 text-on-ink hover:border-white/50'
    : 'border border-line-strong bg-surface px-5 py-2.5 text-ink hover:border-ink/30 hover:shadow-soft',
  ghost: onInk ? 'link-underline text-on-ink' : 'link-underline text-ink',
};
---
<a
  href={href}
  class:list={[base, variants[variant], className]}
  {...(href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <slot />
  {/* Arrow slides out and a copy slides in on hover */}
  <span class="relative inline-flex h-4 w-4 overflow-hidden" aria-hidden="true">
    <Icon name={icon} size={16} class="absolute inset-0 transition-transform duration-[var(--dur-base)] ease-out group-hover:translate-x-[140%]" />
    <Icon name={icon} size={16} class="absolute inset-0 -translate-x-[140%] transition-transform duration-[var(--dur-base)] ease-out group-hover:translate-x-0" />
  </span>
</a>
