---
// Mini product UI mock built from the product's own step titles. Decorative (aria-hidden).
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { product: CollectionEntry<'products'>; class?: string }
const { product, class: className = '' } = Astro.props;
const { data } = product;
---
<div class:list={['rounded-xl border border-line bg-bg p-4 text-left', className]} aria-hidden="true">
  <div class="mb-3 flex items-center gap-1.5">
    <span class="h-2 w-2 rounded-full bg-line-strong"></span><span class="h-2 w-2 rounded-full bg-line-strong"></span><span class="h-2 w-2 rounded-full bg-line-strong"></span>
    <span class="meta ml-2 text-[0.6rem] text-muted">{data.name}</span>
  </div>
  <ul class="space-y-2">
    {['Quarterly report', 'Client proposal', 'Meeting notes'].map((doc, i) => (
      <li class="flex items-center gap-3 rounded-lg border border-line bg-surface px-3 py-2 text-xs text-ink-soft">
        <span class:list={['inline-flex h-4 w-4 items-center justify-center rounded border', i < 2 ? 'border-accent bg-accent text-white' : 'border-line-strong']}>
          {i < 2 && <Icon name="check" size={11} />}
        </span>
        <Icon name="doc" size={14} class="text-muted" />{doc}
        <span class="ml-auto h-1.5 w-12 rounded-full bg-line"></span>
      </li>
    ))}
  </ul>
  <div class="mt-3 flex items-center justify-between">
    <span class="text-[0.7rem] text-muted">{data.howItWorks[1]?.title ?? ''}</span>
    <span class="rounded-full bg-accent px-3 py-1 text-[0.7rem] font-medium text-white">{data.howItWorks[2]?.title ?? 'Run'}</span>
  </div>
</div>
