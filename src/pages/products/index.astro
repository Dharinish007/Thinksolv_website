---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageHero from '@/components/PageHero.astro';
import ProductCard from '@/components/ProductCard.astro';
import ProductMock from '@/components/ProductMock.astro';
import CtaSection from '@/components/CtaSection.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const categories = ['All', ...Array.from(new Set(products.map((p) => p.data.category)))];
const countFor = (c: string) => (c === 'All' ? products.length : products.filter((p) => p.data.category === c).length);
const featuredList = products.filter((p) => p.data.featured);
const arrowBtn = "inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/15 text-on-ink transition-colors duration-[var(--dur-base)] hover:border-accent hover:text-accent";
const featured = featuredList.length ? featuredList : products.slice(0, 1);

// Platform badges come from the collection itself — no platform is shown that has no product.
const platforms = Array.from(new Set(products.map((p) => p.data.platform))).map((pl) => ({
  label: pl,
  icon: pl === 'Chrome Extension' ? 'chrome' : 'workspace',
  count: products.filter((p) => p.data.platform === pl).length,
}));
---
<Base title="Products" description="Focused Google Workspace add-ons for document conversion and automation.">
  <PageHero
    eyebrow="Products"
    lines={['Small tools that', 'remove real work.']}
    accentLast
    intro="Every product is built for people who work daily in Docs, Sheets and Drive — designed to stay out of the way and just work."
    layout="7/5"
  >
    <div slot="aside" class="grid gap-3">
      {platforms.map((pl) => (
        <div class="flex items-center gap-4 rounded-[var(--radius)] border border-line bg-surface p-5">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-line text-ink-soft"><Icon name={pl.icon} size={22} /></span>
          <div class="flex-1">
            <p class="font-medium text-ink">{pl.label}</p>
            <p class="text-sm text-muted">Runs natively inside Docs, Sheets and Drive</p>
          </div>
          <span class="font-display text-3xl font-medium tabular-nums text-ink">{pl.count}</span>
        </div>
      ))}
      <div class="flex items-center justify-between gap-4 rounded-[var(--radius)] border border-line bg-surface-2 px-5 py-4 text-sm">
        <span class="meta text-muted">Categories</span>
        <span class="text-ink-soft">{categories.slice(1).join(' · ')}</span>
      </div>
    </div>
  </PageHero>

  <!-- FEATURED: carousel of featured products (manual only, no autoplay) -->
  <Section tone="ink">
    <section class="overflow-x-clip" aria-roledescription="carousel" aria-label="Featured products" data-carousel>
    <div class="reveal mb-10 flex items-center justify-between gap-4">
      <p class="meta text-on-ink-muted">01 — Featured products</p>
      {featured.length > 1 && (
        <div class="flex items-center gap-3">
          <span class="whitespace-nowrap font-mono text-sm tabular-nums text-on-ink-muted" aria-hidden="true"><span data-carousel-index>1</span> / {featured.length}</span>
          <button type="button" class:list={[arrowBtn, 'lg:hidden']} aria-label="Previous product" data-carousel-prev><Icon name="arrow" size={18} class="rotate-180" /></button>
          <button type="button" class:list={[arrowBtn, 'lg:hidden']} aria-label="Next product" data-carousel-next><Icon name="arrow" size={18} /></button>
        </div>
      )}
    </div>
    <p class="sr-only" aria-live="polite" data-carousel-status></p>
    <div class="relative lg:px-20">
      {featured.length > 1 && (
        <div class="hidden lg:block">
          <button type="button" class:list={[arrowBtn, 'absolute left-0 top-1/2 -translate-y-1/2']} aria-label="Previous product" data-carousel-prev><Icon name="arrow" size={18} class="rotate-180" /></button>
          <button type="button" class:list={[arrowBtn, 'absolute right-0 top-1/2 -translate-y-1/2']} aria-label="Next product" data-carousel-next><Icon name="arrow" size={18} /></button>
        </div>
      )}
      {featured.map((p, i) => (
        <div role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${featured.length}: ${p.data.name}`} hidden={i !== 0} class="showcase-panel grid items-center gap-12 lg:grid-cols-12 lg:gap-8" data-carousel-slide>
          <div class="lg:col-span-5">
            <h2 class="text-[length:var(--text-h1)] leading-[1.04] text-on-ink" style="--i:0">{p.data.name}</h2>
            <p class="mt-5 text-[length:var(--text-lead)] leading-relaxed text-on-ink-muted" style="--i:1">{p.data.tagline}</p>
            <ul class="mt-8 space-y-3 border-t border-white/10 pt-6" style="--i:2">
              {p.data.features.slice(0, 3).map((f) => (
                <li class="flex items-start gap-3 text-sm text-on-ink-muted">
                  <Icon name="check" size={18} class="mt-0.5 shrink-0 text-accent" />
                  <span><strong class="font-medium text-on-ink">{f.title}.</strong> {f.body}</span>
                </li>
              ))}
            </ul>
            <div class="mt-9" style="--i:3"><Button href={`/products/${p.id}`}>Explore {p.data.name}</Button></div>
          </div>
          <div class="showcase-mock relative lg:col-span-6 lg:col-start-7">
            <div class="showcase-glow pointer-events-none absolute -inset-8" aria-hidden="true"></div>
            <div class="relative rounded-[var(--radius-panel)] border border-white/10 bg-ink-2 p-6 md:p-10">
              <ProductMock product={p} class="shadow-lift" />
            </div>
          </div>
        </div>
      ))}
    </div>
    {featured.length > 1 && (
      <div class="mt-12 flex justify-center gap-1">
        {featured.map((p, i) => (
          <button type="button" class="group inline-flex h-11 items-center px-1" aria-label={`Show ${p.data.name}`} aria-current={i === 0 ? 'true' : undefined} data-carousel-dot>
            <span class="block h-2 w-2 rounded-full bg-white/25 transition-[width,background-color] duration-[var(--dur-base)] ease-[var(--ease-out)] group-hover:bg-white/50 group-aria-[current]:w-6 group-aria-[current]:bg-accent"></span>
          </button>
        ))}
      </div>
    )}
    </section>
  </Section>

  <!-- ALL PRODUCTS + FILTER -->
  <Section tone="base">
    <div class="reveal flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="meta mb-4 text-muted">02 — All products</p>
        <h2 class="text-[length:var(--text-h2)] leading-[1.08]">Browse the ecosystem</h2>
      </div>
      <div class="relative inline-flex max-w-full self-start overflow-x-auto rounded-full border border-line bg-surface p-1 [scrollbar-width:none] md:self-auto" role="group" aria-label="Filter products by category" data-filter-group>
        <span class="pointer-events-none absolute left-0 top-1 h-[calc(100%-0.5rem)] rounded-full bg-accent-strong transition-[transform,width] duration-[var(--dur-base)] ease-in-out" aria-hidden="true" data-filter-pill></span>
        {categories.map((c, i) => (
          <button
            type="button"
            class="filter-btn relative z-10 inline-flex items-center gap-2 whitespace-nowrap rounded-full px-3 py-2 text-sm font-medium text-ink-soft transition-colors duration-[var(--dur-base)] aria-pressed:text-white sm:px-4"
            data-filter={c}
            aria-pressed={i === 0 ? 'true' : 'false'}
            aria-label={`${c} (${countFor(c)} products)`}
          ><span class="hidden sm:inline">{c}</span><span class="sm:hidden" aria-hidden="true">{c.split(' ').at(-1)}</span><span class="font-mono text-[0.7rem] opacity-60" aria-hidden="true">{countFor(c)}</span></button>
        ))}
      </div>
    </div>
    <p class="sr-only" role="status" aria-live="polite" data-filter-status></p>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-product-grid>
      {products.map((p) => (
        <div class="product-item" data-category={p.data.category}>
          <ProductCard product={p} />
        </div>
      ))}
    </div>
  </Section>

  <CtaSection title="Not sure which tool fits?" intro="Tell us your workflow and we’ll point you to the right product — or build what’s missing." secondary={{ label: 'Explore services', href: '/services' }} />
</Base>

<script>
  // Featured carousel: prev/next buttons, ←/→ keys, swipe. No autoplay.
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-carousel]');
    if (!root) return;
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
    const index = root.querySelector<HTMLElement>('[data-carousel-index]');
    const status = root.querySelector<HTMLElement>('[data-carousel-status]');
    if (slides.length < 2) return;
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-carousel-dot]'));
    let current = 0;

    const go = (step: number) => {
      if (!step) return;
      current = (current + step + slides.length) % slides.length;
      slides.forEach((s, i) => {
        s.hidden = i !== current;
        s.dataset.dir = step > 0 ? 'next' : 'prev';
      });
      dots.forEach((d, i) => (i === current ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      if (index) index.textContent = String(current + 1);
      if (status) status.textContent = slides[current].getAttribute('aria-label') ?? '';
    };

    dots.forEach((d, i) => d.addEventListener('click', () => go(i - current)));
    root.querySelectorAll('[data-carousel-prev]').forEach((b) => b.addEventListener('click', () => go(-1)));
    root.querySelectorAll('[data-carousel-next]').forEach((b) => b.addEventListener('click', () => go(1)));
    root.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      if (e.key === 'ArrowRight') go(1);
      else if (e.key === 'ArrowLeft') go(-1);
    });
    let startX = 0;
    root.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) go(dx < 0 ? 1 : -1);
    });
  });

  // Segmented filter with FLIP reordering. Re-binds on every ClientRouter navigation.
  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';

  document.addEventListener('astro:page-load', () => {
    const group = document.querySelector<HTMLElement>('[data-filter-group]');
    if (!group) return;
    const pill = group.querySelector<HTMLElement>('[data-filter-pill]')!;
    const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('.filter-btn'));
    const items = Array.from(document.querySelectorAll<HTMLElement>('.product-item'));
    const status = document.querySelector<HTMLElement>('[data-filter-status]');
    let running = 0;

    const placePill = (btn: HTMLElement, animate = true) => {
      if (!animate) pill.style.transition = 'none';
      pill.style.width = `${btn.offsetWidth}px`;
      pill.style.transform = `translateX(${btn.offsetLeft}px)`;
      if (!animate) { pill.offsetWidth; pill.style.transition = ''; }
    };
    const activeBtn = () => buttons.find((b) => b.getAttribute('aria-pressed') === 'true') ?? buttons[0];
    placePill(activeBtn(), false);
    // Labels change length at the sm breakpoint — keep the pill under the active button
    const onResize = () => placePill(activeBtn(), false);
    window.addEventListener('resize', onResize, { passive: true });
    document.addEventListener('astro:before-swap', () => window.removeEventListener('resize', onResize), { once: true });

    const apply = async (filter: string) => {
      const token = ++running;
      items.forEach((el) => el.getAnimations().forEach((a) => a.cancel())); // interrupt a previous run cleanly
      const shouldShow = (el: HTMLElement) => filter === 'All' || el.dataset.category === filter;
      const leaving = items.filter((el) => !el.hidden && !shouldShow(el));
      const entering = items.filter((el) => el.hidden && shouldShow(el));
      const staying = items.filter((el) => !el.hidden && shouldShow(el));
      const count = items.filter(shouldShow).length;
      if (status) status.textContent = `Showing ${count} ${count === 1 ? 'product' : 'products'}${filter === 'All' ? '' : ` in ${filter}`}`;

      if (reduce()) {
        leaving.forEach((el) => (el.hidden = true));
        entering.forEach((el) => { el.hidden = false; el.querySelector('.reveal')?.classList.add('is-visible'); });
        return;
      }

      // 1. fade/scale out removed items. Never block on .finished alone: a tab that isn't rendering
      //    frames never resolves it, so a timer guarantees the filter always completes.
      leaving.forEach((el) => el.animate([{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'scale(0.97)' }], { duration: 160, easing: EASE, fill: 'forwards' }));
      await new Promise((r) => setTimeout(r, leaving.length ? 170 : 0));
      if (token !== running) return;

      // 2. FLIP: measure, swap visibility, invert, play
      const first = new Map(staying.map((el) => [el, el.getBoundingClientRect()]));
      leaving.forEach((el) => { el.hidden = true; el.getAnimations().forEach((a) => a.cancel()); });
      entering.forEach((el) => { el.hidden = false; el.querySelector('.reveal')?.classList.add('is-visible'); });
      staying.forEach((el) => {
        const a = first.get(el)!, b = el.getBoundingClientRect();
        const dx = a.left - b.left, dy = a.top - b.top;
        if (dx || dy) el.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }], { duration: 320, easing: EASE });
      });
      entering.forEach((el, i) =>
        el.animate([{ opacity: 0, transform: 'scale(0.97)' }, { opacity: 1, transform: 'none' }], { duration: 260, delay: 80 + i * 40, easing: EASE, fill: 'backwards' }),
      );
    };

    buttons.forEach((btn) => btn.addEventListener('click', () => {
      if (btn.getAttribute('aria-pressed') === 'true') return;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      placePill(btn);
      apply(btn.dataset.filter || 'All');
    }));
  });
</script>
