---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ProductCard from '@/components/ProductCard.astro';
import StepStory from '@/components/StepStory.astro';
import ProductStepVisual from '@/components/ProductStepVisual.astro';
import CtaSection from '@/components/CtaSection.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import { cta } from '@/data/site';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product, all: products },
  }));
}

const { product, all } = Astro.props;
const { data, id } = product;
const related = all
  .filter((p) => p.id !== product.id && p.data.category === data.category)
  .concat(all.filter((p) => p.id !== product.id && p.data.category !== data.category))
  .slice(0, 3);

// Spec rows render only when a value exists — unverified (CONFIRM) fields stay hidden.
const specs = [
  { k: 'Platform', v: data.platform },
  { k: 'Category', v: data.category },
  { k: 'Rating', v: data.rating != null ? `${data.rating} / 5` : undefined },
  { k: 'Users', v: data.users },
].filter((s) => s.v);

const toc = [
  { id: 'overview', label: 'Overview' },
  { id: 'problem', label: 'Problem & solution' },
  { id: 'how-it-works', label: 'How it works' },
  { id: 'features', label: 'Features' },
  { id: 'outcomes', label: 'Outcomes' },
  ...(related.length ? [{ id: 'related', label: 'Related' }] : []),
];
---
<Base title={data.name} description={data.summary}>
  <div class="read-progress" aria-hidden="true"></div>

  <nav class="toc" aria-label="On this page" data-toc>
    <ul>
      {toc.map((t) => (
        <li><a href={`#${t.id}`} data-toc-link={t.id}><span class="toc-dot"></span><span class="toc-label">{t.label}</span></a></li>
      ))}
    </ul>
  </nav>

  <!-- HERO -->
  <section id="overview" class="relative scroll-mt-24 overflow-hidden pt-32 pb-[var(--section-y-sm)] md:pt-40" data-intro>
    <div class="grid-motif pointer-events-none absolute inset-0 -z-10"></div>
    <div class="container-x">
      <nav aria-label="Breadcrumb" class="intro-fade mb-10 text-sm text-muted" style="--d:0ms">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/products" class="link-underline hover:text-ink">Products</a></li>
          <li aria-hidden="true">/</li>
          <li>{data.category}</li>
          <li aria-hidden="true">/</li>
          <li class="text-ink" aria-current="page">{data.name}</li>
        </ol>
      </nav>
      <div class="grid gap-12 lg:grid-cols-12 lg:items-end lg:gap-8">
        <div class="lg:col-span-7">
          <div class="intro-fade flex items-center gap-4" style="--d:60ms">
            <span class="inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-line bg-surface text-accent" transition:name={`product-icon-${id}`}>
              <Icon name={data.icon} size={28} />
            </span>
            <span class="meta text-muted">{data.category} · {data.platform}</span>
          </div>
          <h1 class="mt-8 text-[length:var(--text-h1)] leading-[1.02] tracking-[-0.03em]">
            <span class="inline-block" transition:name={`product-title-${id}`}>{data.name}</span>
          </h1>
          <p class="intro-fade mt-5 max-w-xl text-[length:var(--text-lead)] leading-relaxed text-muted" style="--d:300ms">{data.tagline}</p>
          <div class="intro-fade mt-9 flex flex-wrap items-center gap-x-6 gap-y-4" style="--d:400ms">
            {data.storeUrl
              ? <Button href={data.storeUrl} icon="arrowUpRight">Get {data.name}</Button>
              : <Button href={cta.primary.href}>Request access</Button>}
            <Button href="#how-it-works" variant="ghost" icon="arrow">See how it works</Button>
          </div>
        </div>
        <aside class="intro-fade lg:col-span-5" style="--d:350ms" aria-label="Product details">
          <div class="rounded-[var(--radius)] border border-line bg-surface p-6 shadow-soft md:p-7">
            <p class="text-sm leading-relaxed text-ink-soft">{data.summary}</p>
            <dl class="mt-6 divide-y divide-line border-t border-line text-sm">
              {specs.map((s) => (
                <div class="flex justify-between gap-4 py-3"><dt class="text-muted">{s.k}</dt><dd class="font-medium text-ink">{s.v}</dd></div>
              ))}
            </dl>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- PROBLEM → SOLUTION -->
  <Section tone="surface" id="problem" class="scroll-mt-16">
    <div class="grid items-stretch gap-6 lg:grid-cols-[1fr_auto_1fr] lg:gap-8">
      <div class="reveal rounded-[var(--radius)] border border-line bg-surface p-8 md:p-10">
        <p class="meta text-muted">Before</p>
        <p class="mt-6 font-display text-[length:var(--text-h3)] leading-snug text-ink-soft">{data.problem}</p>
      </div>
      <div class="reveal flex items-center justify-center text-accent" style="--reveal-delay:80ms" aria-hidden="true">
        <span class="inline-flex h-12 w-12 rotate-90 items-center justify-center rounded-full border border-line-strong bg-bg lg:rotate-0"><Icon name="arrow" size={20} /></span>
      </div>
      <div class="reveal rounded-[var(--radius)] border border-accent/25 bg-surface p-8 shadow-soft md:p-10" style="--reveal-delay:160ms">
        <p class="meta text-accent">After — {data.name}</p>
        <p class="mt-6 font-display text-[length:var(--text-h3)] leading-snug text-ink">{data.solution}</p>
      </div>
    </div>
  </Section>

  <!-- HOW IT WORKS -->
  <Section tone="base" id="how-it-works" class="scroll-mt-16">
    <SectionHeader number="01" eyebrow="How it works" title={`${data.name} in ${data.howItWorks.length} steps`} />
    <div class="mt-12 lg:mt-4">
      <StepStory steps={data.howItWorks} compact>
        {/* Astro slots can't be named dynamically inside a map, so the (up to) three visuals are explicit */}
        {data.howItWorks[0] && <div slot="v0"><ProductStepVisual step={0} title={data.howItWorks[0].title} icon={data.icon} /></div>}
        {data.howItWorks[1] && <div slot="v1"><ProductStepVisual step={1} title={data.howItWorks[1].title} icon={data.icon} /></div>}
        {data.howItWorks[2] && <div slot="v2"><ProductStepVisual step={2} title={data.howItWorks[2].title} icon={data.icon} /></div>}
      </StepStory>
    </div>
  </Section>

  <!-- FEATURES -->
  <Section tone="surface" id="features" class="scroll-mt-16">
    <SectionHeader number="02" eyebrow="Features" title="Built around the details that matter" layout="split" />
    <div class="mt-14 grid gap-x-8 sm:grid-cols-2">
      {data.features.map((f, i) => (
        <div class="reveal grid grid-cols-[3rem_1fr] gap-4 border-t border-line-strong py-7" style={`--reveal-delay:${(i % 2) * 60}ms`}>
          <span class="font-mono text-sm text-muted">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="text-[length:var(--text-h3)]">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{f.body}</p>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- OUTCOMES -->
  <Section tone="ink" id="outcomes" class="scroll-mt-16">
    <SectionHeader number="03" eyebrow="Outcomes" title="What you get back" invert />
    <ol class="mt-12 grid gap-x-8 md:grid-cols-2">
      {data.outcomes.map((o, i) => (
        <li class="reveal flex gap-6 border-t border-white/10 py-8" style={`--reveal-delay:${i * 70}ms`}>
          <Icon name="check" size={22} class="mt-1 shrink-0 text-accent" />
          <span class="font-display text-[length:var(--text-h3)] leading-snug text-on-ink">{o}</span>
        </li>
      ))}
    </ol>
  </Section>

  <!-- RELATED -->
  {related.length > 0 && (
    <Section tone="base" id="related" class="scroll-mt-16">
      <SectionHeader number="04" eyebrow="Related products" title="Explore the rest of the ecosystem" layout="split">
        <Button href="/products" variant="ghost">All products</Button>
      </SectionHeader>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((p) => <ProductCard product={p} />)}
      </div>
    </Section>
  )}

  <CtaSection />
</Base>

<style is:global>
  /* Reading progress: CSS scroll-driven where supported; hidden elsewhere (no JS scroll work) */
  .read-progress { display: none; }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .read-progress {
        display: block;
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 55;
        height: 2px;
        background: var(--color-accent);
        transform-origin: 0 50%;
        animation: read-progress linear both;
        animation-timeline: scroll(root);
      }
    }
  }
  @keyframes read-progress { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  /* On-this-page rail: from 1400px (clears the content margin), labels on hover/focus; always shown at 1536px+ */
  .toc { display: none; }
  @media (min-width: 1400px) {
    .toc {
      display: block;
      position: fixed;
      left: 1rem;
      top: 50%;
      z-index: 40;
      transform: translateY(-50%);
      padding: 0.5rem;
      border: 1px solid var(--color-line);
      border-radius: 1.25rem;
      background: rgb(255 255 255 / 0.85);
      box-shadow: var(--shadow-soft);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
    }
    .toc a {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      padding: 0.4rem 0.5rem;
      border-radius: 999px;
      font-size: 0.8125rem;
      color: var(--color-muted);
      transition: color var(--dur-fast), background-color var(--dur-fast);
    }
    .toc a:hover { color: var(--color-ink); background: var(--color-surface-2); }
    .toc-dot {
      width: 6px; height: 6px; flex-shrink: 0; border-radius: 999px;
      background: var(--color-line-strong);
      transition: background-color var(--dur-base), transform var(--dur-base) var(--ease-out);
    }
    .toc a[aria-current='true'] { color: var(--color-ink); }
    .toc a[aria-current='true'] .toc-dot { background: var(--color-accent); transform: scale(1.4); }
    .toc-label {
      max-width: 0; overflow: hidden; white-space: nowrap; opacity: 0;
      transition: max-width var(--dur-base) var(--ease-out), opacity var(--dur-base);
    }
    .toc:hover .toc-label, .toc:focus-within .toc-label { max-width: 10rem; opacity: 1; }
  }
  @media (min-width: 1536px) {
    .toc-label { max-width: 10rem; opacity: 1; }
  }
</style>

<script>
  // Active-section tracking for the on-this-page rail. Re-binds after each ClientRouter navigation.
  document.addEventListener('astro:page-load', () => {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    if (!links.length) return;
    const sections = links.map((l) => document.getElementById(l.dataset.tocLink!)).filter(Boolean) as HTMLElement[];
    const setActive = (id: string) => links.forEach((l) => l.setAttribute('aria-current', String(l.dataset.tocLink === id)));
    setActive(sections[0]?.id ?? '');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) setActive(e.target.id); });
    }, { rootMargin: '-40% 0px -55% 0px' });
    sections.forEach((s) => io.observe(s));
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  });
</script>
