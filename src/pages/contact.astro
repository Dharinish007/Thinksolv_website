---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageHero from '@/components/PageHero.astro';
import CtaSection from '@/components/CtaSection.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';

const options = [
  { icon: 'mail', t: 'Email us', d: site.email, href: `mailto:${site.email}` },
  { icon: 'spark', t: 'Product help', d: 'Questions about a specific product', href: '/products' },
  { icon: 'layers', t: 'Work with us', d: 'Services & custom workflow solutions', href: '/services' },
];

const field =
  'w-full rounded-xl border border-line bg-bg px-4 py-3 text-ink outline-none transition-[border-color,box-shadow] duration-[var(--dur-base)] placeholder:text-muted hover:border-line-strong focus:border-accent focus:ring-4 focus:ring-accent-soft aria-[invalid=true]:border-accent';
---
<Base title="Contact" description="Talk to the ThinkSolv team about products, services or custom document workflows.">
  <PageHero
    eyebrow="Contact"
    lines={['Tell us what', 'you’re looking for.']}
    accentLast
    intro="Have a question or a workflow worth automating? Our team typically responds within one business day."
  />

  <!-- OPTIONS + FORM: 5/7 -->
  <Section tone="surface">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="reveal min-w-0 lg:col-span-5">
        <p class="meta mb-6 text-muted">Ways to reach us</p>
        <ul class="border-b border-line-strong">
          {options.map((o) => (
            <li>
              <a href={o.href} class="group flex items-center gap-4 border-t border-line-strong py-6">
                <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-line text-ink-soft transition-colors duration-[var(--dur-base)] group-hover:text-accent"><Icon name={o.icon} size={20} /></span>
                <span class="min-w-0 flex-1">
                  <span class="block font-display text-[length:var(--text-h3)] text-ink">{o.t}</span>
                  <span class="mt-1 block truncate text-sm text-muted">{o.d}</span>
                </span>
                <Icon name="arrowUpRight" size={18} class="shrink-0 text-muted transition-transform duration-[var(--dur-base)] group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent" />
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-8 flex items-start gap-3 text-sm">
          <Icon name="clock" size={18} class="mt-0.5 shrink-0 text-accent" />
          <p class="text-muted"><span class="font-medium text-ink">Response time.</span> We aim to reply within one business day.</p>
        </div>
      </div>

      <!-- Form (validation, Netlify attributes and mailto fallback unchanged) -->
      <form
        id="contact-form"
        class="reveal min-w-0 rounded-[var(--radius-panel)] border border-line bg-surface p-6 shadow-soft md:p-10 lg:col-span-7"
        style="--reveal-delay:100ms"
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        data-email={site.email}
        novalidate
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden"><label>Don’t fill this out: <input name="bot-field" /></label></p>

        <p class="meta mb-8 text-muted">Send a message</p>
        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="name" class="mb-2 block text-sm font-medium text-ink">Full name</label>
            <input id="name" name="name" type="text" required autocomplete="name" class={field} />
            <p data-error="name" class="mt-1.5 hidden text-sm text-accent">Please enter your name.</p>
          </div>
          <div>
            <label for="email" class="mb-2 block text-sm font-medium text-ink">Email address</label>
            <input id="email" name="email" type="email" required autocomplete="email" class={field} />
            <p data-error="email" class="mt-1.5 hidden text-sm text-accent">Please enter a valid email.</p>
          </div>
          <div class="sm:col-span-2">
            <label for="subject" class="mb-2 block text-sm font-medium text-ink">Subject <span class="font-normal text-muted">(optional)</span></label>
            <input id="subject" name="subject" type="text" autocomplete="off" class={field} />
          </div>
          <div class="sm:col-span-2">
            <label for="message" class="mb-2 block text-sm font-medium text-ink">Message</label>
            <textarea id="message" name="message" rows="6" required class:list={[field, 'resize-y']}></textarea>
            <p data-error="message" class="mt-1.5 hidden text-sm text-accent">Please add a short message.</p>
          </div>
        </div>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <p id="form-status" role="status" aria-live="polite" class="text-sm text-muted"></p>
          <button type="submit"
            class="group inline-flex items-center justify-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-medium text-white shadow-soft transition-[background-color,scale] duration-[var(--dur-base)] hover:bg-accent-hover active:scale-[0.98] sm:order-2">
            Send message<Icon name="arrow" size={16} class="transition-transform duration-[var(--dur-base)] group-hover:translate-x-0.5" />
          </button>
        </div>
      </form>
    </div>
  </Section>

  <!-- COMPANY DETAILS (verified facts only) -->
  <Section tone="base" class="!py-[var(--section-y-sm)]">
    <dl class="reveal grid border-y border-line sm:grid-cols-3">
      <div class="py-6 sm:pr-8"><dt class="meta text-muted">Company</dt><dd class="mt-2 font-medium text-ink">{site.legalName}</dd></div>
      <div class="border-t border-line py-6 sm:border-l sm:border-t-0 sm:px-8"><dt class="meta text-muted">Founded</dt><dd class="mt-2 font-medium text-ink">{site.founded}</dd></div>
      <div class="border-t border-line py-6 sm:border-l sm:border-t-0 sm:px-8"><dt class="meta text-muted">Email</dt><dd class="mt-2 font-medium text-ink"><a href={`mailto:${site.email}`} class="link-underline">{site.email}</a></dd></div>
    </dl>
  </Section>

  <CtaSection title="Prefer to just start a conversation?" intro="Email us directly — a real person on the team will reply." />
</Base>

<script>
  // Re-bind on every ClientRouter navigation
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status');
    if (!form) return;
    const fields = ['name', 'email', 'message'];
    const showError = (id: string, show: boolean) => {
      const input = form.elements.namedItem(id) as HTMLInputElement | null;
      const err = form.querySelector(`[data-error="${id}"]`);
      input?.setAttribute('aria-invalid', String(show));
      err?.classList.toggle('hidden', !show);
    };
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let ok = true;
      fields.forEach((id) => {
        const input = form.elements.namedItem(id) as HTMLInputElement;
        const valid = id === 'email' ? /.+@.+\..+/.test(input.value.trim()) : input.value.trim().length > 0;
        showError(id, !valid);
        if (!valid) ok = false;
      });
      if (!ok) { if (status) status.textContent = 'Please fix the highlighted fields.'; return; }
      // CONFIRM: wire a real backend (Netlify Forms attrs are set, or use Formspree/Resend).
      // Guaranteed-working fallback: open the user’s mail client pre-filled.
      const data = new FormData(form);
      const subject = encodeURIComponent(String(data.get('subject') || 'Website enquiry'));
      const body = encodeURIComponent(`Name: ${data.get('name')}\nEmail: ${data.get('email')}\n\n${data.get('message')}`);
      if (status) status.textContent = 'Opening your email app to send…';
      window.location.href = `mailto:${form.dataset.email}?subject=${subject}&body=${body}`;
    });
  });
</script>
