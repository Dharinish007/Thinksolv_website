---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import CtaSection from '@/components/CtaSection.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';

const options = [
  { icon: 'mail', t: 'Email us', d: site.email, href: `mailto:${site.email}` },
  { icon: 'spark', t: 'Product help', d: 'Questions about a specific product', href: '/products' },
  { icon: 'layers', t: 'Work with us', d: 'Services & custom workflow solutions', href: '/services' },
];
---
<Base title="Contact" description="Talk to the ThinkSolv team about products, services or custom document workflows.">
  <!-- HERO -->
  <section class="relative overflow-hidden pt-36 pb-14 md:pt-44">
    <div class="grid-motif pointer-events-none absolute inset-0 -z-10"></div>
    <div class="container-x max-w-3xl">
      <p class="reveal mb-5 text-xs font-semibold uppercase tracking-[0.14em] text-accent">Contact</p>
      <h1 class="reveal text-[length:var(--text-h1)] font-semibold leading-[1.05]">Tell us what you’re looking for.</h1>
      <p class="reveal mt-5 max-w-xl text-lg leading-relaxed text-muted" style="--reveal-delay:80ms">
        Have a question or a workflow worth automating? Our team typically responds within one business day.
      </p>
    </div>
  </section>

  <!-- OPTIONS + FORM -->
  <Section tone="surface" class="!pt-6">
    <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
      <!-- Options -->
      <div class="reveal flex flex-col gap-4">
        {options.map((o) => (
          <a href={o.href} class="group flex items-start gap-4 rounded-[var(--radius)] border border-line bg-surface p-6 transition-all hover:-translate-y-0.5 hover:border-accent/30 hover:shadow-soft">
            <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent"><Icon name={o.icon} size={22} /></span>
            <div>
              <p class="font-semibold">{o.t}</p>
              <p class="mt-1 text-sm text-muted">{o.d}</p>
            </div>
            <Icon name="arrowUpRight" size={18} class="ml-auto text-muted transition-transform group-hover:translate-x-0.5" />
          </a>
        ))}
        <div class="mt-2 rounded-[var(--radius)] border border-line bg-surface-2 p-6">
          <p class="inline-flex items-center gap-2 text-sm font-medium text-ink"><Icon name="clock" size={18} class="text-accent" />Response time</p>
          <p class="mt-1.5 text-sm text-muted">We aim to reply within one business day.</p>
        </div>
      </div>

      <!-- Form -->
      <form
        id="contact-form"
        class="reveal rounded-[calc(var(--radius)*1.2)] border border-line bg-surface p-6 shadow-soft md:p-8"
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        novalidate
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden"><label>Don’t fill this out: <input name="bot-field" /></label></p>

        <div class="grid gap-5">
          <div>
            <label for="name" class="mb-1.5 block text-sm font-medium text-ink">Full name</label>
            <input id="name" name="name" type="text" required autocomplete="name"
              class="w-full rounded-xl border border-line bg-bg px-4 py-3 text-ink outline-none transition-colors placeholder:text-muted focus:border-accent aria-[invalid=true]:border-accent" />
            <p data-error="name" class="mt-1 hidden text-sm text-accent">Please enter your name.</p>
          </div>
          <div>
            <label for="email" class="mb-1.5 block text-sm font-medium text-ink">Email address</label>
            <input id="email" name="email" type="email" required autocomplete="email"
              class="w-full rounded-xl border border-line bg-bg px-4 py-3 text-ink outline-none transition-colors placeholder:text-muted focus:border-accent aria-[invalid=true]:border-accent" />
            <p data-error="email" class="mt-1 hidden text-sm text-accent">Please enter a valid email.</p>
          </div>
          <div>
            <label for="subject" class="mb-1.5 block text-sm font-medium text-ink">Subject</label>
            <input id="subject" name="subject" type="text" autocomplete="off"
              class="w-full rounded-xl border border-line bg-bg px-4 py-3 text-ink outline-none transition-colors placeholder:text-muted focus:border-accent" />
          </div>
          <div>
            <label for="message" class="mb-1.5 block text-sm font-medium text-ink">Message</label>
            <textarea id="message" name="message" rows="5" required
              class="w-full resize-y rounded-xl border border-line bg-bg px-4 py-3 text-ink outline-none transition-colors placeholder:text-muted focus:border-accent aria-[invalid=true]:border-accent"></textarea>
            <p data-error="message" class="mt-1 hidden text-sm text-accent">Please add a short message.</p>
          </div>
          <button type="submit"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-medium text-white transition-all hover:bg-accent-hover hover:-translate-y-0.5">
            Send message<Icon name="arrow" size={16} />
          </button>
          <p id="form-status" role="status" aria-live="polite" class="text-sm text-muted"></p>
        </div>
      </form>
    </div>
  </Section>

  <!-- COMPANY DETAILS + LOCATION -->
  <Section tone="base">
    <div class="grid gap-6 md:grid-cols-2">
      <div class="reveal rounded-[var(--radius)] border border-line bg-surface p-8">
        <h2 class="text-[length:var(--text-h3)] font-semibold">Company details</h2>
        <dl class="mt-5 space-y-3 text-sm">
          <div class="flex justify-between gap-4"><dt class="text-muted">Company</dt><dd class="font-medium text-ink">{site.legalName}</dd></div>
          <div class="flex justify-between gap-4"><dt class="text-muted">Founded</dt><dd class="font-medium text-ink">{site.founded}</dd></div>
          <div class="flex justify-between gap-4"><dt class="text-muted">Email</dt><dd class="font-medium text-ink">{site.email} <span class="text-accent">·CONFIRM</span></dd></div>
          <div class="flex justify-between gap-4"><dt class="text-muted">Location</dt><dd class="font-medium text-ink">{site.location} <span class="text-accent">·CONFIRM</span></dd></div>
        </dl>
      </div>
      <div class="reveal rounded-[var(--radius)] border border-line bg-surface-2 p-8">
        <h2 class="inline-flex items-center gap-2 text-[length:var(--text-h3)] font-semibold"><Icon name="map" size={22} class="text-accent" />Location</h2>
        <p class="mt-4 leading-relaxed text-muted">Full registered address and an embedded map can go here once confirmed. We build remotely-first across the team.</p>
        <span class="mt-4 inline-block rounded-full bg-accent-soft px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide text-accent">CONFIRM address</span>
      </div>
    </div>
  </Section>

  <CtaSection title="Prefer to just start a conversation?" intro="Email us directly — a real person on the team will reply." />
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  if (form) {
    const fields = ['name', 'email', 'message'];
    const showError = (id: string, show: boolean) => {
      const input = form.elements.namedItem(id) as HTMLInputElement | null;
      const err = form.querySelector(`[data-error="${id}"]`);
      input?.setAttribute('aria-invalid', String(show));
      err?.classList.toggle('hidden', !show);
    };
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let ok = true;
      fields.forEach((id) => {
        const input = form.elements.namedItem(id) as HTMLInputElement;
        const valid = id === 'email' ? /.+@.+\..+/.test(input.value.trim()) : input.value.trim().length > 0;
        showError(id, !valid);
        if (!valid) ok = false;
      });
      if (!ok) { if (status) status.textContent = 'Please fix the highlighted fields.'; return; }
      // CONFIRM: wire a real backend (Netlify Forms attrs are set, or use Formspree/Resend).
      // Guaranteed-working fallback: open the user’s mail client pre-filled.
      const data = new FormData(form);
      const subject = encodeURIComponent(String(data.get('subject') || 'Website enquiry'));
      const body = encodeURIComponent(`Name: ${data.get('name')}\nEmail: ${data.get('email')}\n\n${data.get('message')}`);
      if (status) status.textContent = 'Opening your email app to send…';
      window.location.href = `mailto:hello@thinksolv.com?subject=${subject}&body=${body}`;
    });
  }
</script>
