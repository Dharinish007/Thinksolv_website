---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import PageHero from '@/components/PageHero.astro';
import StatBand from '@/components/StatBand.astro';
import CtaSection from '@/components/CtaSection.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import { cta } from '@/data/site';

const problems = [
  'Repetitive document work that eats hours every week.',
  'Manual conversions between Docs, PDF, Word and Markdown.',
  'Copy-paste workflows that break formatting and lose structure.',
  'Processes that live in people’s heads instead of in software.',
];

const services = [
  { icon: 'spark', title: 'Document AI', body: 'Automating document creation, conversion and processing so routine work handles itself.' },
  { icon: 'layers', title: 'AppSheet & workflow solutions', body: 'No-code and low-code automation on Google’s platform, tailored to how your team actually works.' },
  { icon: 'workspace', title: 'Workspace integration', body: 'Solutions that fit natively into Docs, Sheets and Drive — no new place for people to learn.' },
  { icon: 'chrome', title: 'Custom extensions', body: 'Focused Chrome tools that remove a specific, repetitive step from everyday work.' },
];

const capabilities = [
  'First-principles problem analysis',
  'Google Workspace add-ons',
  'Chrome extension development',
  'Document conversion pipelines',
  'AppSheet app development',
  'Workflow automation',
  'Data-driven, maintainable systems',
  'Reliability at scale',
];

const steps = [
  { n: '01', t: 'Understand', d: 'We start with the real problem — what the work is for, and whether it needs to exist at all.' },
  { n: '02', t: 'Design', d: 'We choose the simplest architecture that solves it, avoiding complexity by intent.' },
  { n: '03', t: 'Build', d: 'We ship something reliable, integrated and easy to evolve.' },
  { n: '04', t: 'Refine', d: 'We tune it around real usage so it keeps fading into the background.' },
];

const useCases = [
  { t: 'Content & publishing teams', d: 'Draft in Docs, publish everywhere — without the copy-paste cleanup.' },
  { t: 'Operations & admin', d: 'Batch-convert and standardize documents across whole folders.' },
  { t: 'Developers & docs', d: 'Move structured content between Docs, Markdown and PDF cleanly.' },
];
---
<Base title="Services" description="Document AI, AppSheet and workflow solutions that remove repetitive effort from document-centric work.">
  <PageHero
    eyebrow="Services"
    lines={['Remove the work before', 'it reaches your team.']}
    accentLast
    intro="Beyond our products, we build Document AI and workflow solutions with you — designed to eliminate repetitive effort at the system level."
    layout="4/8"
  >
    <Button href={cta.primary.href}>{cta.primary.label}</Button>
  </PageHero>

  <!-- PROBLEMS WE SOLVE -->
  <Section tone="surface">
    <SectionHeader number="01" eyebrow="Problems we solve" title="The work that shouldn’t need a human" intro="If your team spends time on any of these, there is usually a simpler system underneath." layout="split" />
    <ol class="mt-14 grid gap-x-8 md:grid-cols-2">
      {problems.map((p, i) => (
        <li class="reveal grid grid-cols-[3rem_1fr] gap-4 border-t border-line-strong py-8" style={`--reveal-delay:${(i % 2) * 60}ms`}>
          <span class="font-mono text-sm text-muted">{String(i + 1).padStart(2, '0')}</span>
          <span class="font-display text-[length:var(--text-h3)] leading-snug text-ink">{p}</span>
        </li>
      ))}
    </ol>
  </Section>

  <!-- SERVICES: 2x2 bento -->
  <Section tone="base">
    <SectionHeader number="02" eyebrow="What we offer" title="Services built around your workflow" />
    <div class="mt-12 grid gap-5 sm:grid-cols-2">
      {services.map((s, i) => (
        <div class="spotlight reveal flex flex-col rounded-[var(--radius)] border border-line bg-surface p-7 transition-[border-color,box-shadow] duration-[var(--dur-base)] hover:border-line-strong hover:shadow-soft md:p-9" style={`--reveal-delay:${(i % 2) * 70}ms`}>
          <div class="flex items-start justify-between">
            <span class="font-mono text-sm text-muted">{String(i + 1).padStart(2, '0')}</span>
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-line text-ink-soft"><Icon name={s.icon} size={20} /></span>
          </div>
          <h3 class="mt-10 text-[length:var(--text-h3)]">{s.title}</h3>
          <p class="mt-2 max-w-md text-sm leading-relaxed text-muted">{s.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- CAPABILITIES -->
  <Section tone="ink">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <SectionHeader number="03" eyebrow="Capabilities" title="What we bring to the table" invert />
      </div>
      <ul class="flex flex-wrap content-start gap-3 lg:col-span-8">
        {capabilities.map((c, i) => (
          <li class="reveal inline-flex items-center gap-2 rounded-full border border-white/10 bg-ink-2 px-4 py-2.5 text-sm text-on-ink" style={`--reveal-delay:${i * 40}ms`}>
            <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>{c}
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- HOW WE WORK: connected steps -->
  <Section tone="surface">
    <SectionHeader number="04" eyebrow="How we work" title="A deliberate, four-step approach" />
    <ol class="work-steps reveal relative mt-14 grid gap-10 md:grid-cols-4 md:gap-6">
      <span class="work-line" aria-hidden="true"></span>
      {steps.map((s, i) => (
        <li class="relative pl-10 md:pl-0 md:pt-10" style={`--i:${i}`}>
          <span class="work-dot" aria-hidden="true"></span>
          <span class="font-mono text-sm text-accent-ink">{s.n}</span>
          <h3 class="mt-3 text-[length:var(--text-h3)]">{s.t}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{s.d}</p>
        </li>
      ))}
    </ol>
  </Section>

  <!-- USE CASES: 5/7 -->
  <Section tone="base">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <SectionHeader number="05" eyebrow="Use cases" title="Who this is for" intro="Teams whose work runs through documents — and who would rather it ran itself." />
      </div>
      <ul class="lg:col-span-7">
        {useCases.map((u, i) => (
          <li class="reveal flex items-start justify-between gap-6 border-t border-line-strong py-7 last:border-b" style={`--reveal-delay:${i * 60}ms`}>
            <div>
              <h3 class="text-[length:var(--text-h3)]">{u.t}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{u.d}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- PROOF -->
  <Section tone="surface">
    <SectionHeader number="06" eyebrow="Proof" title="Grounded in real usage" intro="The same principles behind our services already power products used by people around the world." />
    <div class="mt-12"><StatBand /></div>
  </Section>

  <CtaSection title="Have a workflow worth automating?" intro="Tell us where the repetitive work is. We’ll help you design it away." />
</Base>

<style>
  /* Connector line draws when the list is revealed: horizontal on md+, vertical on mobile */
  .work-line {
    position: absolute;
    left: 0.3125rem; top: 0.5rem; bottom: 0.5rem; width: 1px;
    background: var(--color-accent);
    transform-origin: top;
    transition: transform 1000ms var(--ease-in-out) 150ms;
  }
  .work-dot {
    position: absolute;
    left: 0; top: 0.35rem;
    width: 11px; height: 11px; border-radius: 999px;
    border: 1px solid var(--color-accent); background: var(--color-surface-2);
    transition: background-color 300ms var(--ease-out);
    transition-delay: calc(250ms + var(--i) * 220ms);
  }
  @media (min-width: 768px) {
    .work-line { left: 0; right: 0; top: 0.3125rem; bottom: auto; width: auto; height: 1px; transform-origin: left; }
    .work-dot { top: 0; }
  }
  :global(html.js) .work-steps:not(:global(.is-visible)) .work-line { transform: scaleY(0); }
  @media (min-width: 768px) {
    :global(html.js) .work-steps:not(:global(.is-visible)) .work-line { transform: scaleX(0); }
  }
  .work-steps:global(.is-visible) .work-dot, :global(html:not(.js)) .work-dot { background: var(--color-accent); }
</style>
