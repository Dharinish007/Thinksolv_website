---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import PageHero from '@/components/PageHero.astro';
import CtaSection from '@/components/CtaSection.astro';
import Icon from '@/components/Icon.astro';
import { values, timeline, metrics, site } from '@/data/site';

// Only verified timeline entries render publicly.
const milestones = timeline.filter((t) => !('confirm' in t && t.confirm));
const teamSize = metrics.find((m) => m.label === 'People on the team' && !m.confirm)?.value;

// Functions are known; individual names/photos are not public yet, so none are shown.
const disciplines = [
  { role: 'Founder & CEO', note: 'Sets product direction and first principles.' },
  { role: 'Technical', note: 'Builds and maintains the product ecosystem.' },
  { role: 'Marketing', note: 'Connects the products with the people who need them.' },
];
---
<Base title="About" description="ThinkSolv is a small team building document-centric software with a long-term, first-principles approach.">
  <PageHero
    eyebrow="About"
    lines={['A small team with', 'a long-term view.']}
    accentLast
    intro={`ThinkSolv began in ${site.founded} as a one-person company. Today we’re ${teamSize ?? 'a small team of'} people building software designed to stay out of the way — and last.`}
  />

  <!-- WHO WE ARE: 5/7 -->
  <Section tone="surface">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <SectionHeader number="01" eyebrow="Who we are" title="Builders of quiet, reliable software" />
      </div>
      <div class="reveal lg:col-span-7" style="--reveal-delay:80ms">
        <p class="font-display text-[length:var(--text-h3)] leading-snug text-ink">
          We build focused tools for document workflows across Google Workspace and Chrome, for people who expect speed, predictability and deep integration.
        </p>
        <p class="mt-6 max-w-xl leading-relaxed text-muted">
          We avoid unnecessary complexity because it increases mental overhead for the people using our tools.
          Simplicity requires intent — and we choose it deliberately, in every product and every line.
        </p>
      </div>
    </div>
  </Section>

  <!-- MISSION + VISION -->
  <Section tone="base">
    <div class="grid md:grid-cols-2">
      <div class="reveal border-t border-line-strong pt-8 md:border-r md:border-t-0 md:pr-12 md:pt-0">
        <div class="flex items-center gap-3 text-muted"><Icon name="target" size={20} class="text-accent" /><span class="meta">Our mission</span></div>
        <p class="mt-6 font-display text-[length:var(--text-h2)] leading-[1.12] text-ink">Remove repetitive effort so individuals and teams can focus on higher-value work.</p>
      </div>
      <div class="reveal mt-12 border-t border-line-strong pt-8 md:mt-0 md:border-t-0 md:pl-12 md:pt-0" style="--reveal-delay:100ms">
        <div class="flex items-center gap-3 text-muted"><Icon name="compass" size={20} class="text-accent" /><span class="meta">Our vision</span></div>
        <p class="mt-6 font-display text-[length:var(--text-h2)] leading-[1.12] text-ink">Software that fades into the background — seamless, stable, and asking for very little attention.</p>
      </div>
    </div>
  </Section>

  <!-- VALUES -->
  <Section tone="surface">
    <SectionHeader number="02" eyebrow="Values" title="What guides every decision" layout="split" />
    <ol class="mt-14 grid gap-x-8 sm:grid-cols-2">
      {values.map((v, i) => (
        <li class="reveal grid grid-cols-[3rem_1fr] gap-4 border-t border-line-strong py-8" style={`--reveal-delay:${(i % 2) * 60}ms`}>
          <span class="font-mono text-sm text-muted">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="text-[length:var(--text-h3)]">{v.title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{v.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <!-- TIMELINE -->
  <Section tone="ink">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <SectionHeader number="03" eyebrow="Timeline" title="How we got here" invert />
      </div>
      <ol class="timeline relative lg:col-span-7 lg:col-start-6">
        <span class="tl-track" aria-hidden="true"><span class="tl-fill"></span></span>
        {milestones.map((t, i) => (
          <li class="reveal relative pb-14 pl-12 last:pb-0" style={`--reveal-delay:${i * 60}ms`}>
            <span class="tl-dot" aria-hidden="true"></span>
            <div class="font-mono text-sm text-accent">{t.year}</div>
            <h3 class="mt-3 text-[length:var(--text-h2)] leading-[1.1] text-on-ink">{t.title}</h3>
            <p class="mt-3 max-w-lg leading-relaxed text-on-ink-muted">{t.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <!-- TEAM -->
  <Section tone="base">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <SectionHeader number="04" eyebrow="Team" title={teamSize ? `Seven people, three disciplines` : 'Three disciplines'} />
        {teamSize && (
          <p class="reveal mt-10 font-display text-[clamp(5rem,4rem+5vw,8rem)] font-medium leading-none tracking-[-0.04em] text-ink" style="--reveal-delay:80ms">
            {teamSize}<span class="meta ml-3 align-top text-muted">people</span>
          </p>
        )}
      </div>
      <ol class="lg:col-span-7 lg:col-start-6">
        {disciplines.map((d, i) => (
          <li class="reveal grid grid-cols-[3rem_1fr] gap-4 border-t border-line-strong py-8 last:border-b" style={`--reveal-delay:${i * 60}ms`}>
            <span class="font-mono text-sm text-muted">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="text-[length:var(--text-h3)]">{d.role}</h3>
              <p class="mt-2 leading-relaxed text-muted">{d.note}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <!-- PULL QUOTE -->
  <Section tone="surface">
    <blockquote class="reveal mx-auto max-w-4xl">
      <p class="font-display text-[length:var(--text-h1)] font-medium leading-[1.08] tracking-[-0.03em] text-ink">
        “Every product begins with a simple question: <span class="text-accent">what if this task didn’t need to exist at all?</span>”
      </p>
      <footer class="mt-8 max-w-xl text-muted">That question guides us to design at the system level — eliminating repetitive work before it reaches the user.</footer>
    </blockquote>
  </Section>

  <CtaSection title="Want to build with a team that keeps it simple?" />
</Base>

<style>
  .tl-track {
    position: absolute; left: 0.3125rem; top: 0.5rem; bottom: 0.5rem; width: 1px;
    background: rgb(255 255 255 / 0.1);
  }
  .tl-fill {
    position: absolute; inset: 0;
    background: var(--color-accent);
    transform-origin: top;
  }
  /* Line draws with scroll where supported; shown fully drawn elsewhere */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .tl-fill {
        animation: tl-draw linear both;
        animation-timeline: view();
        animation-range: entry 20% cover 60%;
      }
    }
  }
  @keyframes tl-draw { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  .tl-dot {
    position: absolute; left: 0; top: 0.25rem;
    width: 11px; height: 11px; border-radius: 999px;
    border: 1px solid var(--color-accent); background: var(--color-ink);
    transition: background-color 400ms var(--ease-out) 200ms;
  }
  li:global(.is-visible) .tl-dot, :global(html:not(.js)) .tl-dot { background: var(--color-accent); }
</style>
